
# Practical 9: Simple STRIPS / Goal-Stack Planning

# Step 1: Define Initial State and Goal
initial_state = {"At_A"}
goal = "At_C"

# Step 2: Define STRIPS Actions
actions = [
    {
        "name": "Move A to B",
        "pre": {"At_A"},
        "add": {"At_B"},
        "delete": {"At_A"}
    },
    {
        "name": "Move B to C",
        "pre": {"At_B"},
        "add": {"At_C"},
        "delete": {"At_B"}
    }
]

# Step 3: Find an Action That Can Achieve a Goal
def find_action(goal):
    for action in actions:
        if goal in action["add"]:
            return action
    return None

# Step 4: Goal-Stack Planner
def make_plan(goal, state, plan):

    # Check if goal is already true
    if goal in state:
        return True

    # Find an action to achieve the goal
    action = find_action(goal)

    if action is None:
        return False

    # Achieve action preconditions
    for condition in action["pre"]:
        if not make_plan(condition, state, plan):
            return False

    # Perform the action
    state.difference_update(action["delete"])
    state.update(action["add"])

    plan.append(action["name"])

    return True

# Step 5: Generate the Plan
state = initial_state.copy()
plan = []

success = make_plan(goal, state, plan)

# Step 6: Display the Result
if success:
    print("Initial State:", initial_state)
    print("Goal State:", goal)
    print("\nPlan:")
    for step in plan:
        print(step)

    print("\nFinal State:", state)
    print("Goal Achieved Successfully!")
else:
    print("No plan found!")
